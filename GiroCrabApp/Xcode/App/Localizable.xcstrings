    "Diagramm" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chart"
          }
        }
      }
    },
    "Diagramm anzeigen" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Chart"
          }
        }
      }
    },
    "Diagramm und Anteile zeigen nur zugeordnete Werte. Summen und Positionen bleiben vollständig." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The chart and percentages show classified assets only. Totals and positions remain complete."
          }
        }
      }
    },
    "Diagrammart" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chart type"
          }
        }
      }
    },
    "Diagrammart (Linie, Balken, Kreis) und Balkenbreite wählen Sie auch direkt unter dem Diagramm. Balken zeigen den durchschnittlichen Saldo je Monat (bei kurzen Zeiträumen je Tag, ab sechs Jahren je Jahr) und machen Trends und Jahre vergleichbar. Gestrichelte Linien markieren den Jahreswechsel." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the chart type (line, bars, pie) and the bar width right below the chart. Bars show the average balance per month (per day for short periods, per year beyond six years) and make trends and years comparable. Dashed lines mark the turn of the year."
          }
        }
      }
    },
    "Die Amazon-Sitzung ist abgelaufen. Bitte erneut anmelden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Amazon session has expired. Please sign in again."
          }
        }
      }
    },
    "Die Anlageklassen zeigen das Bruttovermögen. Abzüglich der Verbindlichkeiten ergibt sich das Nettovermögen oben." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asset classes show gross assets. Subtracting liabilities gives the net worth shown above."
          }
        }
      }
    },
    "Die Anlageklassen zeigen das Bruttovermögen. Verbindlichkeiten sind oben derzeit nicht abgezogen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asset classes show gross assets. Liabilities are currently not deducted above."
          }
        }
      }
    },
    "Die Anzahl muss größer als 0 sein." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The quantity must be greater than 0."
          }
        }
      }
    },
    "Die B2B-Mandate sind bei den Banken der Zahlungspflichtigen hinterlegt" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The B2B mandates are on file at the debtors' banks"
          }
        }
      }
    },
    "Die Bank hat abgelehnt (%@): %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bank hat abgelehnt (%1$@): %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bank declined (%1$@): %2$@"
          }
        }
      }
    },
    "Die Bank hat einen Einzug zurückgegeben. Prüfe die Angaben des Mandats, bevor du erneut einziehst." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bank returned a collection. Check the mandate's details before collecting again."
          }
        }
      }
    },
    "Die Bank hat nicht geantwortet (Zeitüberschreitung)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bank didn’t respond (timeout)."
          }
        }
      }
    },
    "Die Bank liefert sie gebucht erneut" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bank delivers them again once booked"
          }
        }
      }
    },
    "Die Bank verlangt trotzdem eine ausdrückliche Bestätigung, bevor sie die Freigabe anfordert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bank still requires your explicit confirmation before it asks for the approval."
          }
        }
      }
    },
    "Die Datei ist zu groß (höchstens 2 MB)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file is too large (2 MB at most)."
          }
        }
      }
    },
    "Die Datei konnte nicht gelesen werden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file could not be read."
          }
        }
      }
    },
    "Die Daten wurden in den Ordner „GiroCrab“ in iCloud Drive verschoben. Bitte wechseln Sie über „Ordner wählen …“ zu diesem Ordner, damit alle Geräte denselben Ordner nutzen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The data has been moved to the “GiroCrab” folder in iCloud Drive. Please switch to that folder via “Choose folder …” so all devices share the same folder."
          }
        }
      }
    },
    "Die Datenbank verzeichnet %u PDF-Dokumente, die Dateien liegen aber nicht bei dieser Datenbank. Wenn Sie sie gesichert haben, wählen Sie den Ordner aus – sonst werden sie ausgelassen und lassen sich später nachholen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The database lists %u PDF documents, but the files are not next to this database. If you saved them, choose the folder – otherwise they are left out and can be added later."
          }
        }
      }
    },
    "Die Empfängerbank konnte den Namen nicht prüfen%@. Senden Sie nur, wenn Sie sich bei IBAN und Empfänger sicher sind." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recipient's bank could not verify the name%@. Only send if you are sure about the IBAN and recipient."
          }
        }
      }
    },
    "Die Enable-Banking-Anwendung eines anderen Geräts wurde aus dem iCloud-Schlüsselbund übernommen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Enable Banking application of another device was taken from iCloud Keychain."
          }
        }
      }
    },
    "Die Enable-Banking-Anwendung wird bei der ersten Freigabe eingerichtet. Verknüpfen Sie dabei alle Konten dieser Banken auf einmal." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Enable Banking application is set up at the first consent. Link all accounts of these banks at once while doing so."
          }
        }
      }
    },
    "Die Gruppe ist leer." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The group is empty."
          }
        }
      }
    },
    "Die Kategorie wird samt ihren Unterkategorien und Regeln unwiderruflich gelöscht. Zugeordnete Buchungen bleiben erhalten und stehen danach ohne Kategorie da." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The category is permanently deleted along with its subcategories and rules. Assigned bookings are kept and become uncategorized."
          }
        }
      }
    },
    "Die Kategorien ersetzen die GiroCrab-Startkategorien – Ihr Tresor enthält noch keine Buchungen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The categories replace the GiroCrab starter categories – your vault has no transactions yet."
          }
        }
      }
    },
    "Die Konten aus „%@“ kommen nach „%@“. „%@“ wird entfernt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The accounts in “%1$@” move to “%2$@”. “%3$@” is removed."
          }
        }
      }
    },
    "Die Konten erscheinen unter ihrem Bankzugang. Der erste Abruf übernimmt sie, ohne Duplikate anzulegen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The accounts appear under their bank login. The first fetch takes them over without creating duplicates."
          }
        }
      }
    },
    "Die Konten für die Menüleiste wählst du unter Einstellungen › Allgemein." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the accounts for the menu bar under Settings › General."
          }
        }
      }
    },
    "Die PIN wird nicht gespeichert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PIN is not stored."
          }
        }
      }
    },
    "Die PIN wird nur für diesen Abruf verwendet und nie gespeichert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PIN is only used for this fetch and never stored."
          }
        }
      }
    },
    "Die PIN wird verschlüsselt im Tresor gespeichert." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PIN is stored encrypted in the vault."
          }
        }
      }
    },
    "Die PSD2-Zustimmung für %@ ist abgelaufen. Bitte in GiroCrab neu verbinden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PSD2 consent for %@ has expired. Please reconnect in GiroCrab."
          }
        }
      }
    },
    "Die PSD2-Zustimmung für %@ läuft in %lld Tagen ab. Bitte in GiroCrab neu verbinden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PSD2 consent for %1$@ expires in %2$lld days. Please reconnect in GiroCrab."
          }
        }
      }
    },
    "Die Registrierung dauert meist einige Tage. Bis dahin können Sie GiroCrab mit den Demo-Daten ausprobieren." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registration usually takes a few days. Until then, you can try GiroCrab with the demo data."
          }
        }
      }
    },
    "Die Restschuld am Ende des Stichtags, z. B. aus dem Jahreskontoauszug. Raten ab dem Folgetag werden abgezogen. Fehlt etwas oder stimmt etwas nicht, setzen Sie einfach einen neuen Stand." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The outstanding balance at the end of the balance date, e.g. from the annual statement. Payments from the next day on are deducted. If something is missing or wrong, simply set a new balance."
          }
        }
      }
    },
    "Die Sicherheitssperre verhindert direkte Überweisungen von diesem Konto. Am Ende erhalten Sie einen GiroCode zum Scannen in der App Ihrer Bank." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The security lock prevents direct transfers from this account. At the end you get a GiroCode to scan in your bank's app."
          }
        }
      }
    },
    "Die Sicherung enthält alle Konten, Buchungen, Kategorien, Regeln und Einstellungen des Tresors, verschlüsselt mit einem Passwort Ihrer Wahl. Sie lässt sich auf jedem Gerät wiederherstellen, auch ohne diesen Schlüsselbund – aber nicht ohne das Passwort." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup contains all accounts, transactions, categories, rules and settings of the vault, encrypted with a password of your choice. It can be restored on any device, even without this keychain – but not without the password."
          }
        }
      }
    },
    "Die Stornierung wurde von der Bank angenommen, aber noch nicht bestätigt." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bank accepted the cancellation but has not confirmed it yet."
          }
        }
      }
    },
    "Die Systemsprache wurde geändert" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The System Language Has Changed"
          }
        }
      }
    },
    "Die Tags werden bei allen Buchungen entfernt. Die Buchungen bleiben." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tags will be removed from all bookings. The bookings stay."
          }
        }
      }
    },
    "Die Teilbeträge müssen zusammen %@ ergeben (Restbetrag: %@), erst dann lässt sich speichern." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The parts must add up to %@ (remaining: %@) before you can save."
          }
        }
      }
    },
    "Die Teilbeträge müssen zusammen %@ ergeben, erst dann lässt sich speichern." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The parts must add up to %@ before you can save."
          }
        }
      }
    },
    "Die Untergruppen bleiben erhalten und rücken auf die oberste Ebene." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its subgroups are kept and move to the top level."
          }
        }
      }
    },
    "Die Untergruppen bleiben erhalten und rücken nach „%@“." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its subgroups are kept and move to “%@”."
          }
        }
      }
    },
    "Die Verbindung funktioniert: Das Hilfsprogramm erreicht GiroCrab, und der Schlüssel wird angenommen." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection works: the helper reaches GiroCrab, and the key is accepted."
          }
        }
      }
    },
    "Die Webseite meldet:" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The webpage says:"
          }
        }
      }
    },
    "Die Zugangsdaten erstellen Sie einmalig bei Ihrer Bank. GiroCrab speichert sie verschlüsselt im Tresor." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You create these credentials once at your bank. GiroCrab stores them encrypted in the vault."
          }
        }
      }
    },
    "Die Zustimmung geben Sie im Browser Ihrer Bank. Dafür brauchen Sie eine kostenlose eigene Anwendung auf enablebanking.com (Application-ID, privater Schlüssel, Redirect-URL)." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You give consent in your bank's browser page. This needs a free application of your own on enablebanking.com (application ID, private key, redirect URL)."
          }
        }
      }
    },
    "Die bestehende Aufteilung konnte nicht geladen werden." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The existing split could not be loaded."
          }
        }
      }
    },
    "Die comdirect-Schnittstelle (REST) kann keine Überweisungen ausführen. Verbinden Sie das Konto zusätzlich per FinTS, um direkt zu überweisen. Sonst erhalten Sie am Ende einen GiroCode zum Scannen in der comdirect-App." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The comdirect interface (REST) can’t send transfers. Also connect the account via FinTS to transfer directly. Otherwise you’ll get a GiroCode at the end to scan in the comdirect app."
          }
        }
      }
    },
    "Die eigene Zuordnung gilt für diesen Sachwert. Automatisch setzt nur das jeweilige Merkmal zurück." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your choice applies to this tangible asset. Automatic resets only the respective field."
          }
        }
      }
    },
    "Die einzelnen Positionen stehen in der Positionsliste." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The individual positions are listed in the positions list."
          }
        }
      }
    },
    "Die externe Analyse ist ausgeschaltet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "External analysis is turned off."
          }
        }
      }
    },
    "Die externe Analyse ist nur mit Ihrem eigenen, entsperrten Tresor verfügbar – nicht mit den Demo-Daten." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "External analysis is only available with your own unlocked vault – not with the demo data."
          }
        }
      }
    },
    "Die gesamte Dokumentensammlung exportieren, unabhängig von den Filtern" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export the entire document collection, regardless of the filters"
          }
        }
      }
    },
    "Die kleineren Positionen stehen vollständig in der Positionsliste." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The smaller positions are listed in full in the positions list."
          }
        }
      }
    },
    "Die neue Sprache wird nach einem Neustart verwendet." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new language is used after a restart."
          }
        }
      }
    },
    "Die Überweisung konnte nicht storniert werden." : {
